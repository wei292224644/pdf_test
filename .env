# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Qwen API 配置（用于 langextract、lightrag_example、lightrag-server）
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-03f3eb5bc4cf446bafa1c76e762f65ad
LLM_MODEL=qwen3.5-flash-2026-02-23

EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
# Ollama 文本向量接口（skills/gb2760-standard-query 使用）
OLLAMA_EMBED_URL=http://localhost:11434/api/embed
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
EMBEDDING_MODEL=qwen3-embedding:4b
# qwen3-embedding:4b 输出 2560 维，必须与 LightRAG 期望一致，否则报 dimension mismatch
EMBEDDING_DIM=2560

SUMMARY_LANGUAGE=Chinese